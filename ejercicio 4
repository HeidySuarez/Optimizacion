import numpy as np
from scipy.optimize import fsolve

# Datos
K = 1000
r = 0.4
H = 80
P0 = 400

# Modelo
def modelo_pesca(P):
    return P + r * P * (1 - P / K) - H

# Equilibrio
def equilibrio(P):
    return r * P * (1 - P / K) - H

# Resolver equilibrios
P_eq1 = fsolve(equilibrio, 700)[0]
P_eq2 = fsolve(equilibrio, 300)[0]

print("Modelo logístico de pesca\n")

print("Parámetros:")
print(f"K = {K}")
print(f"r = {r}")
print(f"H = {H}")
print(f"P0 = {P0}\n")

print(f"{'Año':<10}{'Población':>15}")
print("-" * 25)

P = P0
print(f"{0:<10}{P:>15.2f}")

for n in range(1, 21):
    P = modelo_pesca(P)
    if P < 0:
        print(f"{n:<10}{'EXTINCIÓN':>15}")
        break
    print(f"{n:<10}{P:>15.2f}")

print("\nEquilibrios:")
print(f"P* alto = {P_eq1:.4f}")
print(f"P* bajo = {P_eq2:.4f}")

# Verificación
print("\nVerificación:")
print(f"En P* alto: {equilibrio(P_eq1):.6f}")
print(f"En P* bajo: {equilibrio(P_eq2):.6f}")

print("\nAdvertencia:")
print(f"Si P < {P_eq2:.2f} -> colapso de la población")
