import numpy as np
from scipy.optimize import minimize

# DATOS
ganancia_F1 = 180
ganancia_F2 = 220

A = 120
B = 80
C = 150

# FUNCIÓN OBJETIVO
def objetivo(x):
    x1, x2 = x
    return -(ganancia_F1 * x1 + ganancia_F2 * x2)

# RESTRICCIONES
def restriccion_A(x):
    x1, x2 = x
    return A - (3*x1 + 4*x2)

def restriccion_B(x):
    x1, x2 = x
    return B - (2*x1 + x2)

def restriccion_C(x):
    x1, x2 = x
    return C - (5*x1 + 3*x2)

restricciones = [
    {'type': 'ineq', 'fun': restriccion_A},
    {'type': 'ineq', 'fun': restriccion_B},
    {'type': 'ineq', 'fun': restriccion_C}
]

# CONDICIONES INICIALES
x0 = [5, 5]
bounds = [(0, None), (0, None)]

# OPTIMIZACIÓN
resultado = minimize(
    objetivo,
    x0,
    method='SLSQP',
    bounds=bounds,
    constraints=restricciones
)

# RESULTADOS
x1_opt, x2_opt = resultado.x
Z_opt = -resultado.fun

print("FERTILIZANTES\n")

print("Estado:", "Óptimo encontrado" if resultado.success else "Fallo")
print()

print(f"x1 (F1) = {x1_opt:.2f} ton/semana")
print(f"x2 (F2) = {x2_opt:.2f} ton/semana")
print(f"Ganancia máxima = ${Z_opt:.2f}\n")

# VERIFICACIÓN
uso_A = 3*x1_opt + 4*x2_opt
uso_B = 2*x1_opt + x2_opt
uso_C = 5*x1_opt + 3*x2_opt

print("Uso de recursos:")
print(f"A: {uso_A:.2f} / {A}")
print(f"B: {uso_B:.2f} / {B}")
print(f"C: {uso_C:.2f} / {C}")
