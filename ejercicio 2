import numpy as np
from scipy.optimize import fsolve

# Datos iniciales
S0 = 200  # sillas en semana 0
M0 = 80   # mesas en semana 0

# Sistema dinámico
def sistema(x):
    S, M = x
    S_sig = 0.6*S + 0.2*M + 40
    M_sig = 0.1*S + 0.5*M + 20
    return S_sig, M_sig

# Ecuaciones de equilibrio
def equilibrio(x):
    S, M = x
    eq1 = 0.4*S - 0.2*M - 40
    eq2 = 0.5*M - 0.1*S - 20
    return [eq1, eq2]

# Punto inicial 
x0 = [100, 50]

# Resolver equilibrio
sol = fsolve(equilibrio, x0)
S_equ, M_equ = sol

print("Ejercicio: Producción semanal de una fábrica")
print("=" * 40)

print(f"Condiciones iniciales: S0 = {S0} | M0 = {M0}\n")

S, M = S0, M0

print(f"{'Semana':<10}{'Sillas (S)':>15}{'Mesas (M)':>15}")
print("-" * 40)
print(f"{0:<10}{S:>15.2f}{M:>15.2f}")

for n in range(1, 11):
    S, M = sistema([S, M])
    print(f"{n:<10}{S:>15.2f}{M:>15.2f}")

print("=" * 40)

print("\nValores de equilibrio:")
print(f"S* = {S_equ:.4f}")
print(f"M* = {M_equ:.4f}")

# Verificación
S_ver, M_ver = sistema([S_equ, M_equ])

print("\nVerificación:")
print(f"S_(n+1) = {S_ver:.4f}  ~ S* = {S_equ:.4f}")
print(f"M_(n+1) = {M_ver:.4f}  ~ M* = {M_equ:.4f}")
print("=" * 40)
